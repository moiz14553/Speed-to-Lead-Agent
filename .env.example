# LLM: gemini or anthropic
LLM_PROVIDER=gemini
# Leave empty for the provider default: gemini-3.8-flash / claude-haiku-5-5
LLM_MODEL=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# USD per 1M tokens, per model. Gemini is 0 on the free tier; set real rates for paid use.
# A model missing from this list adds an error to the response and its LLM cost is not counted.
LLM_RATES={"gemini-3.8-flash":{"input":0,"output":0},"gemini-3.5-flash-lite":{"input":0,"output":0},"claude-haiku-5-5":{"input":0.10,"output":0.50}}

# Search and scraping. Firecrawl is optional: without a key pages are fetched with httpx.
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
# 1 credit per basic search at the pay-as-you-go rate. Set to 0 while inside the free monthly credits.
TAVILY_COST_PER_SEARCH_USD=0
# Depends on your Firecrawl plan. 0 on the free plan.
FIRECRAWL_COST_PER_PAGE_USD=0

# Total time budget for one /enrich run. When it runs out, what was found so far is returned.
ENRICH_TIMEOUT_SECONDS=30
# Timeout for each source
SCRAPE_TIMEOUT_SECONDS=8
TAVILY_TIMEOUT_SECONDS=6
LLM_TIMEOUT_SECONDS=15

# Retry with backoff on LLM rate limits (429) and provider errors (5xx)
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE_SECONDS=1
LLM_BACKOFF_MAX_SECONDS=20

# Max characters of each source sent to the LLM
SOURCE_CHAR_LIMIT=6000

# Save what each lead collected to debug/<run_id>/, for diagnosing misses
DEBUG_SAVE_RAW=false
